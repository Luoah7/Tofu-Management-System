    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@hono/node-server": "^2.0.1",
    "antd": "^5.24.7",
    "antd-mobile": "^5.42.3",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.2",
    "concurrently": "^9.1.2",
    "dayjs": "^1.11.20",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.5",
    "jose": "^6.0.11",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
